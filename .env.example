# PostgreSQL
POSTGRES_USER=evidencefirst
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=evidencefirst

# Connection string usata dagli script Python eseguiti dal sistema host.
# Quando in fase 8.1b gireranno API/Worker dentro container, useranno host=db.
DATABASE_URL=postgresql+psycopg://evidencefirst:devpassword@localhost:5432/evidencefirst
# Redis
REDIS_URL=redis://localhost:6379/0

# Storage locale (non ancora usato in 8.1a; sarà montato dai servizi in 8.1b)
STORAGE_LOCAL_ROOT=./storage

# Cost cap (nessun provider reale in MVP-0)
MAX_COST_PER_TASK=0
PROVIDERS_ENABLED=mock

# Logging
LOG_LEVEL=info
